{
  "name": "obsidian-gtd-tasks",
  "version": "0.2.2",
  "description": "GTD task organizer for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "validate-translations": "node scripts/validate-translations.mjs",
    "check-icons": "node scripts/check-icons.mjs",
    "build": "tsc -noEmit -skipLibCheck && npm run lint && node esbuild.config.mjs production",
    "release-check": "npm run validate-translations && npm run build && npm test && npm run test:perf",
    "lint": "eslint src/",
    "test": "jest --passWithNoTests",
    "test:perf": "jest --config jest.perf.config.js --runInBand"
  },
  "keywords": [],
  "author": "Vitaly Ditman",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/sortablejs": "^1.15.7",
    "esbuild": "^0.27.3",
    "esbuild-svelte": "^0.8.1",
    "eslint": "^9.39.3",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^17.3.0",
    "jest": "^29.7.0",
    "obsidian": "^1.13.0",
    "svelte": "^5.53.6",
    "svelte-preprocess": "^5.1.0",
    "ts-jest": "^29.1.0",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "i18next": "^26.3.1",
    "sortablejs": "^1.15.2"
  }
}
